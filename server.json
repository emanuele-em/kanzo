{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.emanuele-em/kanzo",
  "title": "Kanzo",
  "description": "Self-hosted kanban for humans and agents. One 4.7 MB binary, starts in 3 ms, zero setup.",
  "repository": {
    "url": "https://github.com/emanuele-em/kanzo",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "kanzo",
      "version": "0.4.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
